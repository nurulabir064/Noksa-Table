# Server-side Neon PostgreSQL pooled connection string. Never expose this to Vite.
DATABASE_URL=

# Keep false until privacy, operations, notifications and admin workflow are ready.
RESERVATIONS_ENABLED=false

# Long random secret for hashing client IPs in the database rate limiter.
RATE_LIMIT_SECRET=

# Public, HTTPS privacy notice URL. Required before accepting reservation data.
PRIVACY_POLICY_URL=

# Frontend feature flags. Keep reservations disabled until backend setup is complete.
VITE_RESERVATIONS_ENABLED=false
VITE_PRIVACY_POLICY_URL=

# SSLCOMMERZ — reserved for the future server-side payment integration.
# Do not enable until merchant onboarding and the sandbox test matrix pass.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
